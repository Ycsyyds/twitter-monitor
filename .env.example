# 复制成 .env 或放到 ~/.config/twitter-monitor/.env (chmod 600)，不要提交真实 key
# llm.js 会按以下顺序查找：
#   1. process.env.MINIMAX_API_KEY
#   2. ~/.config/twitter-monitor/.env
#   3. <project>/.env
MINIMAX_API_KEY=sk-api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认 base URL
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
